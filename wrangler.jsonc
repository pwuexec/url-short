{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "url-short",
	"account_id": "2716bf6ee8be2880904e70f19050d2ef",
	"main": "src/index.tsx",
	"compatibility_date": "2026-02-26",
	"analytics_engine_datasets": [
		{ "binding": "ANALYTICS", "dataset": "url_shortener" }
	],
	"kv_namespaces": [
		{
			"binding": "URLS",
			"id": "3415530c510c4f9f9264a7e6bd9ad46f"
		}
	],
	"vars": {
		"GOOGLE_CLIENT_ID": "807407300179-4do0ikprrc793uqp1vqfu2enp84v779p.apps.googleusercontent.com"
	},
	"dev": {
		"port": 8792
	},
	"unsafe": {
		"bindings": [
			{
				"name": "RL_CREATE",
				"type": "ratelimit",
				"namespace_id": "1001",
				"simple": { "limit": 5, "period": 60 }
			},
			{
				"name": "RL_REDIRECT",
				"type": "ratelimit",
				"namespace_id": "1002",
				"simple": { "limit": 60, "period": 60 }
			}
		]
	},
}
